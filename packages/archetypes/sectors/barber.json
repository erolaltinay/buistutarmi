{
  "id": "barber",
  "version": 1,
  "model": "service",
  "name": {
    "tr": "Berber",
    "en": "Barbershop"
  },
  "page": {
    "summary": {
      "tr": "Berberde sınırı koltuk sayısı ve gün içindeki saatler koyar. Kira ve ustalarla birlikte günde kaç müşteriye ihtiyacın olduğunu, bunun kapasitene sığıp sığmadığını ve gereken toplam yatırımı kendi rakamlarınla hesapla.",
      "en": "A barbershop is limited by its chairs and its hours. Work out how many customers you need each day with rent and barbers included, whether that fits your capacity, and the total investment you need, using your own numbers."
    },
    "video": { "tr": null, "en": null }
  },
  "unit": {
    "tr": ["müşteri", "müşteri / gün"],
    "en": ["clients", "clients / day"]
  },
  "googlePlaceTypes": ["barber_shop"],
  "osmTags": [
    {
      "shop": "hairdresser"
    }
  ],
  "siteRequirements": null,
  "requiresCertificate": "mastery",
  "capexTemplate": [
    {
      "k": "chairs",
      "type": "equipment",
      "label": {
        "tr": "Berber koltukları",
        "en": "Barber chairs"
      }
    },
    {
      "k": "mirrors",
      "type": "equipment",
      "label": {
        "tr": "Ayna + istasyonlar",
        "en": "Mirrors + stations"
      }
    },
    {
      "k": "tools",
      "type": "equipment",
      "label": {
        "tr": "Makine, makas, sterilizatör",
        "en": "Clippers, shears, sterilizer"
      }
    },
    {
      "k": "furnitureB",
      "type": "furniture",
      "label": {
        "tr": "Bekleme alanı + dekor",
        "en": "Waiting area + decor"
      }
    },
    {
      "k": "buildout",
      "type": "buildout",
      "label": {
        "tr": "Tadilat",
        "en": "Build-out"
      }
    },
    {
      "k": "pos",
      "type": "equipment",
      "label": {
        "tr": "POS + küçük ekipman",
        "en": "POS + smallwares"
      }
    },
    {
      "k": "stockB",
      "type": "inventory",
      "depreciable": false,
      "label": {
        "tr": "İlk ürün stoğu",
        "en": "Opening retail stock"
      }
    },
    {
      "k": "permits",
      "type": "permit",
      "depreciable": false,
      "label": {
        "tr": "Ruhsat / kuruluş",
        "en": "Licenses + permits"
      }
    }
  ],
  "fixedTemplate": [
    {
      "k": "rent",
      "type": "rent",
      "label": {
        "tr": "Kira",
        "en": "Rent"
      }
    },
    {
      "k": "staff3b",
      "type": "staff",
      "label": {
        "tr": "Personel (3 berber)",
        "en": "Staff (3 barbers)"
      }
    },
    {
      "k": "utilities",
      "type": "other",
      "label": {
        "tr": "Elektrik / su / doğalgaz",
        "en": "Utilities"
      }
    },
    {
      "k": "internet",
      "type": "other",
      "label": {
        "tr": "İnternet / telefon",
        "en": "Internet / phone"
      }
    },
    {
      "k": "accounting",
      "type": "other",
      "label": {
        "tr": "Muhasebe",
        "en": "Accounting"
      }
    },
    {
      "k": "otherFixed",
      "type": "other",
      "label": {
        "tr": "Diğer (temizlik, sigorta…)",
        "en": "Other (cleaning, insurance…)"
      }
    }
  ],
  "itemTemplate": [
    {
      "k": "cut",
      "signature": true,
      "label": {
        "tr": "Saç kesimi",
        "en": "Haircut"
      }
    },
    {
      "k": "beard",
      "label": {
        "tr": "Sakal",
        "en": "Beard trim"
      }
    },
    {
      "k": "combo",
      "label": {
        "tr": "Saç + sakal",
        "en": "Cut + beard"
      }
    }
  ],
  "capacity": {
    "defaults": {
      "stations": 3,
      "hours": 10,
      "serviceMin": 40
    }
  },
  "competition": {
    "saturationPeoplePerBusiness": [1200, 2500],
    "qualityWeaknessKeys": ["inconsistent", "shabby"],
    "overpricedWeaknessKey": "expensive",
    "tags": {
      "strengths": {
        "cheap": {
          "tr": "Uygun fiyat",
          "en": "Low prices"
        },
        "masters": {
          "tr": "Usta kadro",
          "en": "Skilled barbers"
        },
        "booking": {
          "tr": "Online randevu",
          "en": "Online booking"
        },
        "premium": {
          "tr": "Premium deneyim",
          "en": "Premium feel"
        },
        "location": {
          "tr": "Konum",
          "en": "Prime spot"
        },
        "fast": {
          "tr": "Hızlı",
          "en": "Quick"
        },
        "loyalty": {
          "tr": "Abonelik",
          "en": "Membership"
        },
        "kids": {
          "tr": "Çocuk kesimi",
          "en": "Kids’ cuts"
        }
      },
      "weaknesses": {
        "wait": {
          "tr": "Uzun bekleme",
          "en": "Long waits",
          "tactic": {
            "tr": "Online randevu ve \"bekleme yok\" sözü ver.",
            "en": "Offer online booking and a \"no waiting\" promise."
          }
        },
        "expensive": {
          "tr": "Pahalı",
          "en": "Pricey",
          "tactic": {
            "tr": "Rakip fiyatının biraz altında bir \"günün kahvesi\" ile kapıdan içeri çek.",
            "en": "Pull people in with a \"coffee of the day\" priced just under rivals."
          }
        },
        "noAppt": {
          "tr": "Randevu yok",
          "en": "No booking",
          "tactic": {
            "tr": "Online randevuyu ilk günden aç, hatırlatma mesajı gönder.",
            "en": "Open online booking from day one with reminder texts."
          }
        },
        "shabby": {
          "tr": "Bakımsız mekan",
          "en": "Tired interior",
          "tactic": {
            "tr": "Temiz, aydınlık ve modern bir mekan ilk bakışta kazanır.",
            "en": "A clean, bright, modern space wins at first glance."
          }
        },
        "digital": {
          "tr": "Dijitalde zayıf",
          "en": "Weak online",
          "tactic": {
            "tr": "Google Haritalar profilini ilk gün tamamla: fotoğraf, menü, saatler.",
            "en": "Finish your Google Maps profile on day one: photos, menu, hours."
          }
        },
        "inconsistent": {
          "tr": "Tutarsız kalite",
          "en": "Inconsistent cuts",
          "tactic": {
            "tr": "Standart bir kesim menüsü kur, her işi fotoğrafla ve paylaş.",
            "en": "Build a standard cut menu, photograph every cut and post it."
          }
        },
        "closesEarly": {
          "tr": "Erken kapanıyor",
          "en": "Closes early",
          "tactic": {
            "tr": "Akşam geç saate kadar açık kal; mesai sonrası müşteri senin olur.",
            "en": "Stay open late and take the after-work crowd."
          }
        },
        "badReviews": {
          "tr": "Kötü yorumlar",
          "en": "Poor reviews",
          "tactic": {
            "tr": "Her yorumu yanıtla, ilk 50 yoruma odaklan; puan farkı tek başına müşteri çeker.",
            "en": "Reply to every review and chase your first 50; a better rating alone pulls customers."
          }
        }
      }
    },
    "sampleCompetitorNames": {
      "b_chain": {
        "tr": "Zincir kuaför (örnek)",
        "en": "Chain salon (example)"
      },
      "b_local": {
        "tr": "Mahalle berberi (örnek)",
        "en": "Old-school barber (example)"
      },
      "b_prem": {
        "tr": "Premium barbershop (örnek)",
        "en": "Premium barbershop (example)"
      },
      "b_unisex": {
        "tr": "Unisex salon (örnek)",
        "en": "Unisex salon (example)"
      }
    }
  },
  "demandFit": {
    "features": [
      {
        "key": "working",
        "weight": 40,
        "expr": "clamp((a1+a2-40)/30)"
      },
      {
        "key": "income",
        "weight": 30,
        "expr": "idx==null ? 0.5 : clamp((idx-60)/60)"
      },
      {
        "key": "density",
        "weight": 30,
        "expr": "clamp(pop/15000)"
      }
    ]
  },
  "location": {
    "captureRatePct": [0.6, 1.5],
    "rentToSalesPct": [15, 22],
    "checklistOverrides": {
      "staffAvail": {
        "tr": "Bölgede iyi usta bulmak kolay",
        "en": "Skilled barbers are easy to hire here"
      }
    }
  },
