  "competition": {
    "saturationPeoplePerBusiness": [1500, 3000],
    "qualityWeaknessKeys": ["ordinary"],
    "overpricedWeaknessKey": "expensive",
    "tags": {
      "strengths": {
        "fast": {
          "tr": "Hızlı servis",
          "en": "Fast service"
        },
        "cheap": {
          "tr": "Uygun fiyat",
          "en": "Low prices"
        },
        "specialty": {
          "tr": "Spesiyalite kahve",
          "en": "Specialty coffee"
        },
        "work": {
          "tr": "Çalışma alanı",
          "en": "Work-friendly"
        },
        "location": {
          "tr": "Konum",
          "en": "Prime spot"
        },
        "loyalty": {
          "tr": "Sadakat programı",
          "en": "Loyalty program"
        },
        "early": {
          "tr": "Erken açılış",
          "en": "Opens early"
        },
        "menu": {
          "tr": "Geniş menü",
          "en": "Big menu"
        }
      },
      "weaknesses": {
        "slow": {
          "tr": "Yavaş servis",
          "en": "Slow service",
          "tactic": {
            "tr": "Sabah için \"kahven 2 dakikada\" sözü ver, mobil ön sipariş kur.",
            "en": "Promise \"your coffee in 2 minutes\" for the morning rush and add mobile pre-order."
          }
        },
        "expensive": {
          "tr": "Pahalı",
          "en": "Pricey",
          "tactic": {
            "tr": "Rakip fiyatının biraz altında bir \"günün kahvesi\" ile kapıdan içeri çek.",
            "en": "Pull people in with a \"coffee of the day\" priced just under rivals."
          }
        },
        "ordinary": {
          "tr": "Sıradan kahve",
          "en": "Average coffee",
          "tactic": {
            "tr": "Tek bir imza içecekte gerçek fark yarat, açılışta ücretsiz tadım yap.",
            "en": "Make one signature drink clearly better and run free tastings at launch."
          }
        },
        "seating": {
          "tr": "Oturma yeri az",
          "en": "Little seating",
          "tactic": {
            "tr": "Prizli, sessiz bir çalışma köşesi ayır; laptop müşterisini al.",
            "en": "Set aside a quiet corner with outlets and take the laptop crowd."
          }
        },
        "lateOpen": {
          "tr": "Geç açılıyor",
          "en": "Opens late",
          "tactic": {
            "tr": "Rakiplerden bir saat erken aç; işe gidenler senin olur.",
            "en": "Open an hour before rivals and own the commuter crowd."
          }
        },
        "digital": {
          "tr": "Dijitalde zayıf",
          "en": "Weak online",
          "tactic": {
            "tr": "Google Haritalar profilini ilk gün tamamla: fotoğraf, menü, saatler.",
            "en": "Finish your Google Maps profile on day one: photos, menu, hours."
          }
        },
        "badReviews": {
          "tr": "Kötü yorumlar",
          "en": "Poor reviews",
          "tactic": {
            "tr": "Her yorumu yanıtla, ilk 50 yoruma odaklan; puan farkı tek başına müşteri çeker.",
            "en": "Reply to every review and chase your first 50; a better rating alone pulls customers."
          }
        },
        "noisy": {
          "tr": "Gürültülü",
          "en": "Noisy",
          "tactic": {
            "tr": "Müzik ve akustikle \"sakin yer\" olarak konumlan.",
            "en": "Use music and acoustics to be \"the calm place\"."
          }
        }
      }
    },
    "sampleCompetitorNames": {
      "c_chain": {
        "tr": "Zincir kafe (örnek)",
        "en": "Chain café (example)"
      },
      "c_local": {
        "tr": "Mahalle kahvecisi (örnek)",
        "en": "Corner deli (example)"
      },
      "c_third": {
        "tr": "Üçüncü dalga kafe (örnek)",
        "en": "Third-wave café (example)"
      },
      "c_bakery": {
        "tr": "Fırın-kafe (örnek)",
        "en": "Bakery café (example)"
      }
    }
  },
  "demandFit": {
    "features": [
      {
        "key": "young",
        "weight": 40,
        "expr": "clamp((a1-15)/25)"
      },
      {
        "key": "income",
        "weight": 35,
        "expr": "idx==null ? 0.5 : clamp((idx-70)/60)"
      },
      {
        "key": "daytime",
        "weight": 25,
        "expr": "clamp(dayR/0.5)"
      }
    ]
  },
  "location": {
    "captureRatePct": [2, 4],
    "rentToSalesPct": [12, 18],
    "checklistOverrides": {
